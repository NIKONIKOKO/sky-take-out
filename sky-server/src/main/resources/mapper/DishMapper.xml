<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.sky.mapper.DishMapper">
    <select id="selectDishPageByNameOrCategoryIdOrStatus" resultType="com.sky.vo.DishVO">
        select d.*, c.name as categoryName
        from dish d
        left join category c on d.category_id = c.id
        <where>
            <if test = "name != null and name != ''">
                and d.name like CONCAT('%', #{name}, '%')
            </if>
            <if test = "categoryId != null and categoryId != 0">
                and d.category_id = #{categoryId}
            </if>
            <if test = "status != null">
                and d.status = #{status}
            </if>
        </where>
    </select>
    <select id="selectDishVOById" resultMap="dishMap">
        select
            d.id d_id,
            d.name d_name,
            d.category_id d_category_id,
            d.price d_price,
            d.image d_image,
            d.description d_description,
            d.status d_status,
            d.update_time d_update_time,
            c.name as c_name,
            df.id df_id,
            df.dish_id df_dish_id,
            df.name df_name,
            df.value df_value
        from dish d
        left join category c on d.category_id = c.id
        left join dish_flavor df on d.id = df.dish_id
        where d.id = #{id}
    </select>
    <resultMap id="dishMap" type="com.sky.vo.DishVO">
        <id property="id" column="d_id"/>
        <result property="name" column="d_name"/>
        <result property="categoryId" column="d_category_id"/>
        <result property="price" column="d_price"/>
        <result property="image" column="d_image"/>
        <result property="description" column="d_description"/>
        <result property="status" column="d_status"/>
        <result property="updateTime" column="d_update_time"/>
        <result property="categoryName" column="c_name"/>
        <collection property="flavors" ofType="com.sky.entity.DishFlavor">
            <id property="id" column="df_id"/>
            <result property="dishId" column="df_dish_id"/>
            <result property="name" column="df_name"/>
            <result property="value" column="df_value"/>
        </collection>
    </resultMap>
    <delete id="deleteDishesByIds">
        delete from dish where id in
        <foreach item="id" collection="list" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
